{
  "name": "steel-billing-portable",
  "version": "1.0.2",
  "description": "Portable offline Windows app for steel utensils dispatch entries and slips.",
  "main": "electron/main.js",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "start": "electron .",
    "dist": "pnpm build && electron-builder --win nsis portable --publish never",
    "dist:installer": "pnpm build && electron-builder --win nsis --publish never",
    "dist:portable": "pnpm build && electron-builder --win portable --publish never",
    "dist:dir": "pnpm build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "sql.js": "latest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "tailwindcss": "latest",
    "vite": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "in.hardikkanajariya.steelutensilsdispatchbook",
    "productName": "Steel Utensils Dispatch Book",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "extraResources": [
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "SteelUtensilsDispatchBook-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "SteelUtensilsDispatchBook-Portable-${version}.${ext}"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller"
    ]
  }
}
